# Copy to .env and adjust. Values below work as-is with docker-compose.yml.
# Read by docker compose, sbt build settings (Flyway only), and the Play app in
# both startup and tests (utils.DotenvConfig / DotenvApplicationLoader).
# Real environment variables take precedence over .env.

# Dev database (used by runserver, migrate, seed)
DATABASE_NAME=auctionite_dev
# Separate database used by `manage.py test` — created and destroyed per run
TEST_DATABASE_NAME=auctionite_test

DATABASE_USER=auctionite
DATABASE_PASSWORD=auctionite
DATABASE_HOST=localhost
DATABASE_PORT=5432

REDIS_HOST=localhost
REDIS_PORT=6379